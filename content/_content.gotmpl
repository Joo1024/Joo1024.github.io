{{/* Generate the shared page list, chronological posts and archive. */}}
{{ $seen := slice }}
{{ $cultivation := slice }}
{{ range site.Data.sections }}
  {{ if in $seen .slug }}{{ errorf "Duplicate page %s in data/sections.yaml" .slug }}{{ end }}
  {{ $seen = $seen | append .slug }}
  {{ $cultivation = $cultivation | append .slug }}
{{ end }}
{{ .AddPage (dict "kind" "section" "path" "posts" "title" "Posts" "params" (dict "chinese" "文字")) }}
{{ .AddPage (dict "kind" "page" "path" "cultivation" "title" "Cultivation" "layout" "list" "params" (dict "chinese" "修行" "entries" $cultivation)) }}
{{ .AddPage (dict "kind" "page" "path" "archive" "title" "Archive" "layout" "archive" "description" "沿着年份与标签，回看全部文字。") }}
