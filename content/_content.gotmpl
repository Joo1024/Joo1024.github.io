{{/* Generate Cultivation, Posts, Archive and Updates; navigation labels live in data/. */}}
{{ $seen := slice }}
{{ range site.Data.sections }}
  {{ if not (in (slice "page" "articles") .kind) }}
    {{ errorf "Section %s kind must be page or articles in data/sections.yaml" .slug }}
  {{ end }}
  {{ if in $seen .slug }}{{ errorf "Duplicate section %s in data/sections.yaml" .slug }}{{ end }}
  {{ $seen = $seen | append .slug }}
  {{ if eq .kind "articles" }}
    {{ $.AddPage (dict "kind" "section" "path" .slug "title" .name "description" .description "params" (dict "chinese" .chinese)) }}
  {{ end }}
{{ end }}
{{ .AddPage (dict "kind" "page" "path" "cultivation" "title" "Cultivation" "layout" "cultivation" "description" "今朝、道途、境界与灵根：最近的实践、长期方向与功法、当前修为及自身禀赋。" "params" (dict "chinese" "修行")) }}
{{ .AddPage (dict "kind" "page" "path" "archive" "title" "Archive" "layout" "archive" "description" "沿着年份与标签，回看全部文字。") }}
{{ .AddPage (dict "kind" "page" "path" "updates" "title" "Updates" "layout" "updates" "description" "新的记录与旧文后记，按最后更新时间排列。") }}
